# =============================================================================
#  content-creation — variables d'environnement
#  Copie ce fichier en .env puis remplis les valeurs :
#     cp .env.example .env
#  Les secrets se génèrent avec :  openssl rand -hex 32
# =============================================================================

# Domaine de base (utilisé pour toutes les routes + portail Authelia)
# ⚠️ Remplacer par ton vrai domaine/hostname. Pour du 100% local sans DNS :
#    - /etc/hosts : 127.0.0.1 content.local  + 127.0.0.1 auth.content.local
#    - ou un domaine .nip.io / .sslip.io qui résout vers une IP sans config DNS
DOMAIN=content.example.com

# --- Secrets Authelia (openssl rand -hex 32) ---
AUTHELIA_SESSION_SECRET=change_me
AUTHELIA_STORAGE_ENCRYPTION_KEY=change_me
AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET=change_me
