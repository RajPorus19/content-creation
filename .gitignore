# Secrets & données locales — ne jamais committer
.env

# Certificats ACME (contient des clés privées)
traefik/certs/*
!traefik/certs/.gitkeep

# Données runtime Authelia
authelia/db.sqlite3
authelia/db.sqlite3-*
authelia/notifications.txt

# Sources des apps (clonées depuis upstream, trackées dans leur propre repo git)
# (ancré à la racine avec « / » pour ne pas ignorer patches/fish-speech/)
/brightbean-studio/
/fish-speech/


# Python
__pycache__/
*.pyc

# Sorties du moteur (MP4 générés)
/engine/output/

# Clips gameplay téléchargés (assets locaux, gros binaires — voir engine/README.md)
/engine/assets/backgrounds/
